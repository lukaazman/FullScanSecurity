<?xml version="1.0" encoding="utf-8"?>
<!-- Suite type scale and components, mirrored in TabTensor src/theme.ts. -->
<resources>
    <style name="TextAppearance.FullScan.Display" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.FullScan.Title" parent="TextAppearance.FullScan.Display">
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.FullScan.Section" parent="TextAppearance.FullScan.Display">
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.FullScan.Body" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/instrument_sans_regular</item>
        <item name="fontFamily">@font/instrument_sans_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.FullScan.Caption" parent="TextAppearance.FullScan.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/fsMuted</item>
    </style>

    <style name="TextAppearance.FullScan.Meta" parent="TextAppearance.FullScan.Body">
        <item name="android:fontFamily">@font/instrument_sans_medium</item>
        <item name="fontFamily">@font/instrument_sans_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/fsFaint</item>
    </style>

    <style name="TextAppearance.FullScan.Label" parent="TextAppearance.FullScan.Body">
        <item name="android:fontFamily">@font/instrument_sans_semibold</item>
        <item name="fontFamily">@font/instrument_sans_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="Widget.FullScan.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FullScan.Label</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="backgroundTint">@color/button_primary</item>
        <item name="rippleColor">@color/accent_deep</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.FullScan.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FullScan.Label</item>
        <item name="android:textColor">@color/ink</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/active</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.FullScan.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FullScan.Label</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="rippleColor">@color/active</item>
    </style>

    <style name="Widget.FullScan.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/checkbox_tint</item>
    </style>

    <!-- Layout building blocks shared by the six screens. -->
    <style name="FullScan.Screen" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="FullScan.Column" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">32dp</item>
    </style>

    <style name="FullScan.ScreenTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FullScan.Title</item>
    </style>

    <style name="FullScan.ScreenSubtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAppearance">@style/TextAppearance.FullScan.Caption</item>
    </style>

    <style name="FullScan.List" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="FullScan.WideButton" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>
</resources>
