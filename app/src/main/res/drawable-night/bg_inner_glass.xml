<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#AA1E222D"
                android:endColor="#BE12151D" />
            <stroke
                android:width="1dp"
                android:color="#30CFC3F5" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <gradient
                android:angle="270"
                android:startColor="#0AFFFFFF"
                android:endColor="#02FFFFFF" />
        </shape>
    </item>
</layer-list>
