<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#C0221C2E"
                android:centerColor="#BA181B25"
                android:endColor="#CC11141B" />
            <stroke
                android:width="1dp"
                android:color="#40D4C7FF" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient
                android:angle="270"
                android:startColor="#12FFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#03FFFFFF" />
        </shape>
    </item>
</layer-list>
