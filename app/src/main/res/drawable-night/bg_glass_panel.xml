<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="270"
                android:startColor="#B41F2430"
                android:centerColor="#A3171B24"
                android:endColor="#BF11141B" />
            <stroke
                android:width="1dp"
                android:color="#33D3C6FF" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="270"
                android:startColor="#0DFFFFFF"
                android:endColor="#02FFFFFF" />
        </shape>
    </item>
</layer-list>
