<?xml version="1.0" encoding="utf-8"?>
<!-- Suite header: app mark, name and the on-device note. Same structure as the TabTensor AppHeader. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mark" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.FullScan.Section" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/header_note"
        android:textAppearance="@style/TextAppearance.FullScan.Meta" />
</LinearLayout>
